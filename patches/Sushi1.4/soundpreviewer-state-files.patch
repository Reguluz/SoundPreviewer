diff --git a/src/engine/preview_state_probe.h b/src/engine/preview_state_probe.h
new file mode 100644
index 0000000..4060cf9
--- /dev/null
+++ b/src/engine/preview_state_probe.h
@@ -0,0 +1,65 @@
+// Research-only helpers for the SoundPreviewer Sushi compatibility probe.
+// These are not part of the shipping application or the upstream Sushi API.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace sushi::internal::jsonconfig::preview_probe {
+
+inline std::vector<std::byte> read_binary(const std::string& path)
+{
+    std::ifstream stream(std::filesystem::u8path(path), std::ios::binary | std::ios::ate);
+    if (!stream)
+        throw std::runtime_error("Cannot open state input file");
+    const auto length = stream.tellg();
+    constexpr std::streamoff max_bytes = 256 * 1024 * 1024;
+    if (length <= 0 || length > max_bytes)
+        throw std::runtime_error("State file is empty or exceeds 256 MiB probe limit");
+    std::vector<std::byte> bytes(static_cast<std::size_t>(length));
+    stream.seekg(0);
+    if (!stream.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size())))
+        throw std::runtime_error("Cannot read complete state input file");
+    return bytes;
+}
+
+inline std::uint32_t big_u32(const std::vector<std::byte>& bytes, std::size_t offset)
+{
+    return (std::to_integer<std::uint32_t>(bytes.at(offset)) << 24) |
+           (std::to_integer<std::uint32_t>(bytes.at(offset + 1)) << 16) |
+           (std::to_integer<std::uint32_t>(bytes.at(offset + 2)) << 8) |
+            std::to_integer<std::uint32_t>(bytes.at(offset + 3));
+}
+
+inline std::vector<std::byte> read_fxp_chunk(const std::string& path)
+{
+    const auto bytes = read_binary(path);
+    if (bytes.size() < 60 || std::memcmp(bytes.data(), "CcnK", 4) != 0 ||
+        std::memcmp(bytes.data() + 8, "FPCh", 4) != 0)
+        throw std::runtime_error("Probe only accepts a CcnK/FPCh single-program FXP");
+    const auto declared_size = big_u32(bytes, 4);
+    const auto chunk_size = big_u32(bytes, 56);
+    // Some real FXP writers include the leading eight bytes in byteSize.
+    if ((static_cast<std::uint64_t>(declared_size) + 8 != bytes.size() && declared_size != bytes.size()) ||
+        chunk_size == 0 || static_cast<std::uint64_t>(chunk_size) + 60 != bytes.size())
+        throw std::runtime_error("Truncated or invalid FPCh chunk size");
+    return {bytes.begin() + 60, bytes.begin() + 60 + chunk_size};
+}
+
+inline void write_binary(const std::string& path, const std::vector<std::byte>& bytes)
+{
+    if (bytes.empty())
+        throw std::runtime_error("Plugin returned an empty binary state");
+    std::ofstream stream(std::filesystem::u8path(path), std::ios::binary | std::ios::trunc);
+    if (!stream || !stream.write(reinterpret_cast<const char*>(bytes.data()),
+                                 static_cast<std::streamsize>(bytes.size())))
+        throw std::runtime_error("Cannot write complete round-trip state file");
+}
+
+} // namespace sushi::internal::jsonconfig::preview_probe
