<Application x:Class="SoundPreviewer.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#167C69" />
  <SolidColorBrush x:Key="Muted" Color="#64716B" />
  <SolidColorBrush x:Key="Line" Color="#DCE2DE" />
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
   <Setter Property="FontSize" Value="13" />
   <Setter Property="Foreground" Value="#202C26" />
   <Setter Property="Background" Value="#F5F7F6" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,8" />
   <Setter Property="Margin" Value="0,0,8,0" />
   <Setter Property="Background" Value="White" />
   <Setter Property="BorderBrush" Value="{StaticResource Line}" />
   <Setter Property="Foreground" Value="#25392D" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.78" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
   <Setter Property="FontSize" Value="17" />
   <Setter Property="Width" Value="38" />
   <Setter Property="Height" Value="36" />
   <Setter Property="Padding" Value="0" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,6" />
   <Setter Property="BorderBrush" Value="{StaticResource Line}" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="8,6" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False" />
   <Setter Property="CanUserAddRows" Value="False" />
   <Setter Property="CanUserDeleteRows" Value="False" />
   <Setter Property="HeadersVisibility" Value="Column" />
   <Setter Property="GridLinesVisibility" Value="Horizontal" />
   <Setter Property="HorizontalGridLinesBrush" Value="#EEF1EF" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="RowHeight" Value="42" />
   <Setter Property="ColumnHeaderHeight" Value="36" />
   <Setter Property="Background" Value="White" />
   <Setter Property="RowBackground" Value="White" />
   <Setter Property="AlternatingRowBackground" Value="#FAFCFB" />
   <Setter Property="SelectionMode" Value="Single" />
   <Setter Property="SelectionUnit" Value="FullRow" />
   <Setter Property="EnableRowVirtualization" Value="True" />
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="8,0" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style x:Key="GridText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="TextTrimming" Value="CharacterEllipsis" />
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Padding" Value="8,0" />
   <Setter Property="Background" Value="#F0F4F2" />
   <Setter Property="Foreground" Value="#53665B" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="BorderThickness" Value="0,0,0,1" />
   <Setter Property="BorderBrush" Value="{StaticResource Line}" />
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="20,11" />
   <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}" />
   <Setter Property="Margin" Value="0,12,0,6" />
  </Style>
 </Application.Resources>
</Application>
