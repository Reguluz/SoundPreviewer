<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoundPreviewer.App.AppearanceDialog"
        Title="主题与配色" Width="460" Height="810" MinWidth="420" MinHeight="560"
        MaxHeight="940" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
 <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
  <StackPanel Spacing="6" Margin="0,0,0,18">
   <TextBlock Text="主题与配色" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="选择喜欢的色调" Foreground="{DynamicResource Muted}"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="18" Margin="0,0,8,8">
    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="20" Padding="4">
     <UniformGrid Columns="3">
      <ToggleButton x:Name="LightMode" Tag="light" Content="浅色" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="浅色主题"/>
      <ToggleButton x:Name="DarkMode" Tag="dark" Content="深色" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="深色主题"/>
      <ToggleButton x:Name="SystemMode" Tag="system" Content="跟随系统" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="跟随系统主题"/>
     </UniformGrid>
    </Border>
    <StackPanel Spacing="10">
     <TextBlock Text="预设配色" Foreground="{DynamicResource Muted}"/>
     <UniformGrid Columns="3">
      <ToggleButton x:Name="SagePreset" Tag="sage" Click="Preset_Click" Classes="filter-option" Height="92" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="苔绿配色">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border Width="40" Height="40" CornerRadius="20" Background="#53694D"><Ellipse Width="17" Height="17" Fill="#A9C39C" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="苔绿" HorizontalAlignment="Center"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="LavenderPreset" Tag="lavender" Click="Preset_Click" Classes="filter-option" Height="92" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="雾紫配色">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border Width="40" Height="40" CornerRadius="20" Background="#746087"><Ellipse Width="17" Height="17" Fill="#C7B5DD" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="雾紫" HorizontalAlignment="Center"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="BluePreset" Tag="blue" Click="Preset_Click" Classes="filter-option" Height="92" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="海蓝配色">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border Width="40" Height="40" CornerRadius="20" Background="#376681"><Ellipse Width="17" Height="17" Fill="#A0CFEC" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="海蓝" HorizontalAlignment="Center"/></StackPanel>
      </ToggleButton>
     </UniformGrid>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <StackPanel Spacing="10">
     <TextBlock Text="自定义颜色" Foreground="{DynamicResource Muted}"/>
     <TextBlock Text="点击色块选色，或直接输入 #RRGGBB。修改会实时预览。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/>
     <StackPanel Name="ColorFieldsPanel" Spacing="9"/>
     <Border Name="PickerPanel" IsVisible="False" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14">
      <StackPanel Spacing="7">
       <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Name="PickerSwatch" Width="24" Height="24" CornerRadius="6"/>
        <TextBlock Grid.Column="1" Name="PickerLabel" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button Grid.Column="2" Content="完成" Classes="compact" Margin="0" Click="ClosePicker_Click"/>
       </Grid>
       <TextBlock Text="色相" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Grid>
        <Border Height="14" VerticalAlignment="Center" CornerRadius="7"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Offset="0" Color="#FF0000"/><GradientStop Offset="0.167" Color="#FFFF00"/><GradientStop Offset="0.333" Color="#00FF00"/><GradientStop Offset="0.5" Color="#00FFFF"/><GradientStop Offset="0.667" Color="#0000FF"/><GradientStop Offset="0.833" Color="#FF00FF"/><GradientStop Offset="1" Color="#FF0000"/></LinearGradientBrush></Border.Background></Border>
        <Slider Name="HueSlider" Minimum="0" Maximum="360" Value="0" AutomationProperties.Name="色相"/>
       </Grid>
       <TextBlock Text="饱和度" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Slider Name="SaturationSlider" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="饱和度"/>
       <TextBlock Text="明度" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Slider Name="ValueSlider" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="明度"/>
      </StackPanel>
     </Border>
     <Expander Header="更多颜色" HorizontalAlignment="Stretch">
      <StackPanel Name="AdvancedColorFieldsPanel" Spacing="9" Margin="0,10,0,0"/>
     </Expander>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <StackPanel Spacing="10">
     <TextBlock Text="实时预览" Foreground="{DynamicResource Muted}"/>
     <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14">
      <StackPanel Spacing="12">
       <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="SoundPreviewer" FontWeight="SemiBold"/><TextBlock Text="合成器音色库" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
        <Button Grid.Column="1" Classes="primary compact" Content="▶  生成 / 继续" Margin="0" IsHitTestVisible="False"/>
       </Grid>
       <UniformGrid Columns="3">
        <Border Background="{DynamicResource SuccessBackground}" CornerRadius="12" Padding="5" Margin="0,0,6,0"><TextBlock Text="已生成" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Success}"/></Border>
        <Border Background="{DynamicResource NeutralBackground}" CornerRadius="12" Padding="5" Margin="0,0,6,0"><TextBlock Text="待生成" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource NeutralForeground}"/></Border>
        <Border Background="{DynamicResource DangerBackground}" CornerRadius="12" Padding="5"><TextBlock Text="生成失败" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}"/></Border>
       </UniformGrid>
      </StackPanel>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" Margin="0,13,0,0">
   <TextBlock Name="ValidationMessage" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
    <Button Name="ResetDefaultsButton" Content="恢复默认" Classes="compact" Click="ResetDefaults_Click" Margin="0"/>
    <Button Grid.Column="2" Name="SaveButton" Content="✓  应用配色" Classes="primary" Click="Save_Click" IsDefault="True" MinWidth="130" Margin="0"/>
   </Grid>
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
    <TextBlock Text="保存后下次沿用；取消会还原本次修改。" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="取消" Classes="compact" Click="Cancel_Click" IsCancel="True" Margin="8,0,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
