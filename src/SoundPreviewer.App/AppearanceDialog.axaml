<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoundPreviewer.App.AppearanceDialog"
        Title="{DynamicResource text_CC003E11F3F5F013}" Width="460" Height="810" MinWidth="420" MinHeight="560"
        MaxHeight="940" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
 <Window.Styles>
  <Style Selector="TextBlock.appearance-section">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style Selector="ToggleButton.appearance-preset">
   <Setter Property="Height" Value="80"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="6"/>
  </Style>
 </Window.Styles>
 <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
  <StackPanel Spacing="6" Margin="0,0,0,18">
   <TextBlock Text="{DynamicResource text_CC003E11F3F5F013}" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock Text="{DynamicResource text_964677C7EE5FA083}" Foreground="{DynamicResource Muted}"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="18" Margin="0,0,8,8">
    <Border Background="{DynamicResource OptionsBandBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="4">
     <UniformGrid Columns="3">
      <ToggleButton x:Name="LightMode" Tag="light" Content="{DynamicResource text_AA0819DFC4D8D782}" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="{DynamicResource text_8D4DB977DF1F8BFB}"/>
      <ToggleButton x:Name="DarkMode" Tag="dark" Content="{DynamicResource text_A6B75D0680322A61}" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="{DynamicResource text_F7E761E280E1D751}"/>
      <ToggleButton x:Name="SystemMode" Tag="system" Content="{DynamicResource text_217CFE7DB1E3D10A}" Classes="filter-tab" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Mode_Click" AutomationProperties.Name="{DynamicResource text_484092C739E4A3F9}"/>
     </UniformGrid>
    </Border>
    <StackPanel Spacing="10">
     <TextBlock Text="{DynamicResource text_7D37622A431D7E8D}" Classes="appearance-section"/>
     <UniformGrid Columns="4">
      <ToggleButton x:Name="SilverPreset" Tag="silver" Click="Preset_Click" Classes="filter-option appearance-preset" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource text_A69740E7317C8EE8}">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border x:Name="SilverPresetSwatch" Width="36" Height="28" CornerRadius="4"><Border x:Name="SilverPresetHighlight" Width="12" Height="18" CornerRadius="2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="{DynamicResource text_787F6D56219D37C4}" HorizontalAlignment="Center" FontSize="12"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="SagePreset" Tag="sage" Click="Preset_Click" Classes="filter-option appearance-preset" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource text_B5789F9565F2159C}">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border x:Name="SagePresetSwatch" Width="36" Height="28" CornerRadius="4"><Border x:Name="SagePresetHighlight" Width="12" Height="18" CornerRadius="2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="{DynamicResource text_E13D2A8DD2E64A03}" HorizontalAlignment="Center" FontSize="12"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="LavenderPreset" Tag="lavender" Click="Preset_Click" Classes="filter-option appearance-preset" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource text_F57CDB85FCCAD496}">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border x:Name="LavenderPresetSwatch" Width="36" Height="28" CornerRadius="4"><Border x:Name="LavenderPresetHighlight" Width="12" Height="18" CornerRadius="2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="{DynamicResource text_47546F21228088BA}" HorizontalAlignment="Center" FontSize="12"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="BluePreset" Tag="blue" Click="Preset_Click" Classes="filter-option appearance-preset" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource text_3344C8DBD35024CF}">
       <StackPanel Spacing="8" HorizontalAlignment="Center"><Border x:Name="BluePresetSwatch" Width="36" Height="28" CornerRadius="4"><Border x:Name="BluePresetHighlight" Width="12" Height="18" CornerRadius="2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border><TextBlock Text="{DynamicResource text_D3F08A6BA56A166D}" HorizontalAlignment="Center" FontSize="12"/></StackPanel>
      </ToggleButton>
     </UniformGrid>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <StackPanel Spacing="10">
     <TextBlock Text="{DynamicResource text_781B07FDCB56B56A}" Classes="appearance-section"/>
     <TextBlock Text="{DynamicResource text_EA46823EAD00B93F}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/>
     <StackPanel Name="ColorFieldsPanel" Spacing="9"/>
     <Border Name="PickerPanel" IsVisible="False" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="14">
      <StackPanel Spacing="7">
       <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Name="PickerSwatch" Width="24" Height="24" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
        <TextBlock Grid.Column="1" Name="PickerLabel" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button Grid.Column="2" Content="{DynamicResource text_C0B3FBFF51CCC40B}" Classes="compact" Margin="0" Click="ClosePicker_Click"/>
       </Grid>
       <TextBlock Text="{DynamicResource text_3FF6D1C07CFCB35A}" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Grid>
        <Border Height="14" VerticalAlignment="Center" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Offset="0" Color="#FF0000"/><GradientStop Offset="0.167" Color="#FFFF00"/><GradientStop Offset="0.333" Color="#00FF00"/><GradientStop Offset="0.5" Color="#00FFFF"/><GradientStop Offset="0.667" Color="#0000FF"/><GradientStop Offset="0.833" Color="#FF00FF"/><GradientStop Offset="1" Color="#FF0000"/></LinearGradientBrush></Border.Background></Border>
        <Slider Name="HueSlider" Minimum="0" Maximum="360" Value="0" AutomationProperties.Name="{DynamicResource text_3FF6D1C07CFCB35A}"/>
       </Grid>
       <TextBlock Text="{DynamicResource text_762F17E26780A94B}" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Slider Name="SaturationSlider" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="{DynamicResource text_762F17E26780A94B}"/>
       <TextBlock Text="{DynamicResource text_C5FCE2A15BEEF4BD}" FontSize="11" Foreground="{DynamicResource Muted}"/>
       <Slider Name="ValueSlider" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="{DynamicResource text_C5FCE2A15BEEF4BD}"/>
      </StackPanel>
     </Border>
     <Expander Header="{DynamicResource text_C71ECB658EE6D5E0}" HorizontalAlignment="Stretch">
      <StackPanel Name="AdvancedColorFieldsPanel" Spacing="9" Margin="0,10,0,0"/>
     </Expander>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <StackPanel Spacing="10">
     <TextBlock Text="{DynamicResource text_A76FDAAD75198128}" Classes="appearance-section"/>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
      <StackPanel Spacing="0">
       <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12">
        <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="SoundPreviewer" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource text_E562D8E9923095EF}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
        <Button Grid.Column="1" Classes="primary compact" Content="{DynamicResource text_453F03F2074616FD}" Margin="0" IsHitTestVisible="False"/>
        </Grid>
       </Border>
       <UniformGrid Columns="3" Margin="12">
        <Border Background="{DynamicResource SuccessBackground}" CornerRadius="4" Padding="5" Margin="0,0,6,0"><TextBlock Text="{DynamicResource text_11448FFF91A477DC}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Success}"/></Border>
        <Border Background="{DynamicResource NeutralBackground}" CornerRadius="4" Padding="5" Margin="0,0,6,0"><TextBlock Text="{DynamicResource text_49933A1953501C0A}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource NeutralForeground}"/></Border>
        <Border Background="{DynamicResource DangerBackground}" CornerRadius="4" Padding="5"><TextBlock Text="{DynamicResource text_470F92DB3D64DBBB}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}"/></Border>
       </UniformGrid>
      </StackPanel>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" Margin="0,13,0,0">
   <TextBlock Name="ValidationMessage" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
    <Button Name="ResetDefaultsButton" Content="{DynamicResource text_BA2E93E73037C71E}" Classes="compact" Click="ResetDefaults_Click" Margin="0" ToolTip.Tip="{DynamicResource text_107F5B061320775B}"/>
    <Button Grid.Column="2" Name="SaveButton" Content="{DynamicResource text_9E7D734659860793}" Classes="primary" Click="Save_Click" IsDefault="True" MinWidth="130" Margin="0"/>
   </Grid>
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
    <TextBlock Text="{DynamicResource text_C691BD090F7E3F30}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="{DynamicResource text_2CD0F3BE8738A86C}" Classes="compact" Click="Cancel_Click" IsCancel="True" Margin="8,0,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
