<Application x:Class="SoundPreviewer.App.App"
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:SoundPreviewer.App"
 RequestedThemeVariant="Light">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#287E91" />
  <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Muted" Color="#657481" />
  <SolidColorBrush x:Key="Line" Color="#D1D8DF" />
  <SolidColorBrush x:Key="WindowBackground" Color="#F1F3F5" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#E9EDF1" />
  <SolidColorBrush x:Key="TextPrimary" Color="#263440" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#E0F0F3" />
  <SolidColorBrush x:Key="HoverBackground" Color="#EDF5F7" />
  <SolidColorBrush x:Key="Warning" Color="#94632B" />
  <SolidColorBrush x:Key="Success" Color="#397665" />
  <SolidColorBrush x:Key="Danger" Color="#AC515B" />
  <SolidColorBrush x:Key="SuccessBackground" Color="#EBF1F0" />
  <SolidColorBrush x:Key="WarningBackground" Color="#F4EFEA" />
  <SolidColorBrush x:Key="DangerBackground" Color="#F7EEEE" />
  <SolidColorBrush x:Key="NeutralBackground" Color="#E9EDF1" />
  <SolidColorBrush x:Key="NeutralForeground" Color="#657481" />
  <SolidColorBrush x:Key="SurfaceHighlight" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0%,0%" EndPoint="0%,100%">
   <GradientStop Offset="0" Color="#FFFFFF"/><GradientStop Offset="1" Color="#FAFBFC"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ControlBackground" StartPoint="0%,0%" EndPoint="0%,100%">
   <GradientStop Offset="0" Color="#FFFFFF"/><GradientStop Offset="1" Color="#F8FAFB"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="OptionsBandBackground" StartPoint="0%,0%" EndPoint="0%,100%">
   <GradientStop Offset="0" Color="#EDF1F4"/><GradientStop Offset="1" Color="#E9EDF1"/>
  </LinearGradientBrush>
  <local:SourceDetectionConverter x:Key="SourceDetection"/>
  <local:RenderBackendValues x:Key="RenderBackendValues"/>
  <local:BackendLabelConverter x:Key="BackendLabel"/>
  <local:BackendIndexConverter x:Key="BackendIndex"/>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme/>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
  <Style Selector="Window">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
  </Style>
  <Style Selector="Button">
   <Setter Property="Padding" Value="13,7"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.primary">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.secondary">
   <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
   <Setter Property="Opacity" Value="0.88"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Opacity" Value="0.65"/>
  </Style>
  <Style Selector="Button.icon">
   <Setter Property="FontFamily" Value="Arial, PingFang SC, Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="Width" Value="38"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.compact">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Padding" Value="9,4"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab, ToggleButton.filter-option">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Height" Value="24"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="Padding" Value="8,2"/>
   <Setter Property="Margin" Value="0,0,5,3"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="CornerRadius" Value="5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab">
   <Setter Property="Height" Value="30"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Padding" Value="6,3"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
   <Setter Property="CornerRadius" Value="5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab:checked, ToggleButton.filter-option:checked">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-option:checked /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ToggleButton.filter-tab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-option:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
  </Style>
  <Style Selector="Button.icon.compact">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="Border.filter-count">
   <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
   <Setter Property="CornerRadius" Value="3"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.filter-count TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style Selector="ToggleButton.filter-option:checked Border.filter-count">
   <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
  </Style>
  <Style Selector="ToggleButton.filter-option:checked Border.filter-count TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Grid.filter-strip TextBox, Grid.filter-strip ComboBox">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Padding" Value="7,4"/>
  </Style>
  <Style Selector="Grid.filter-strip TextBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Border.preset-details TextBlock">
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Border.preset-details TextBlock.field-label">
   <Setter Property="Margin" Value="0,9,0,4"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style Selector="Border.preset-details Button.icon">
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
  </Style>
  <Style Selector="Border.metadata-chip">
   <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="4"/>
   <Setter Property="Padding" Value="8,3"/>
   <Setter Property="Margin" Value="0,0,5,4"/>
  </Style>
  <Style Selector="Border.metadata-chip TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="DataGrid#PresetGrid DataGridColumnHeader">
   <Setter Property="Padding" Value="6,0"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="ListBox.recent-log ListBoxItem">
   <Setter Property="MinHeight" Value="20"/>
   <Setter Property="Padding" Value="3,1"/>
  </Style>
  <Style Selector="ListBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="TextBox">
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ComboBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style Selector="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowHeight" Value="42"/>
   <Setter Property="ColumnHeaderHeight" Value="36"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="SelectionMode" Value="Single"/>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
   <Setter Property="Fill" Value="{DynamicResource HoverBackground}"/>
   <Setter Property="Opacity" Value="1"/>
   <Setter Property="RadiusX" Value="0"/>
   <Setter Property="RadiusY" Value="0"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
   <Setter Property="Fill" Value="{DynamicResource SelectionBackground}"/>
   <Setter Property="Opacity" Value="1"/>
   <Setter Property="RadiusX" Value="0"/>
   <Setter Property="RadiusY" Value="0"/>
  </Style>
  <Style Selector="DataGridRow:selected">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="DataGridCell">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="DataGridCell TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderThickness" Value="0,1,0,0"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SurfaceHighlight}"/>
  </Style>
  <Style Selector="TabItem">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="16,7"/>
   <Setter Property="Margin" Value="0,0,4,4"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <ControlTemplate>
     <Border x:Name="TabHeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
    </ControlTemplate>
   </Setter>
  </Style>
  <Style Selector="TabItem:pointerover">
   <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="TabItem:selected, TabItem:selected:pointerover">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TabItem:disabled">
   <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="CheckBox, RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Expander">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
   <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
   <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
   <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
  </Style>
  <Style Selector="TextBlock.field-label">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Margin" Value="0,12,0,6"/>
  </Style>
  <Style Selector="Border.card">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style Selector="Border.status-badge">
   <Setter Property="Background" Value="{DynamicResource NeutralBackground}"/>
   <Setter Property="CornerRadius" Value="4"/>
   <Setter Property="Padding" Value="9,3"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.status-badge TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{DynamicResource NeutralForeground}"/>
  </Style>
  <Style Selector="Border.status-badge.failed">
   <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
  </Style>
  <Style Selector="Border.status-badge.failed TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Border.status-badge.generated TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Success}"/>
  </Style>
  <Style Selector="Border.status-badge.generated">
   <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
  </Style>
  <Style Selector="Border.status-badge.rendering">
   <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
  </Style>
  <Style Selector="Border.status-badge.rendering TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.status-badge.warning">
   <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
  </Style>
  <Style Selector="Border.status-badge.warning TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
  </Style>
 </Application.Styles>
</Application>
