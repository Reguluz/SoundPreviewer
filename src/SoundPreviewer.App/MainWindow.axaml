<Window x:Class="SoundPreviewer.App.MainWindow"
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:SoundPreviewer.App"
 Title="SoundPreviewer · 合成器音色库" Width="1380" Height="900" MinWidth="1040" MinHeight="700"
 Opened="Window_Loaded" Closing="Window_Closing">
 <Grid Background="#F5F7F6">
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="♫" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
     <StackPanel><TextBlock x:Name="AppBrandName" Text="SoundPreviewer" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="合成器音色库" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ScanPluginsButton" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="扫描系统、用户和自定义安装目录，识别已安装音源" AutomationProperties.Name="扫描已安装音源"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="扫描音源"/></StackPanel></Button>
     <Button x:Name="ScanPresetsButton" Click="Scan_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="扫描已配置的预制目录，更新音色库" AutomationProperties.Name="扫描音色目录"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="扫描音色"/></StackPanel></Button>
     <CheckBox x:Name="ForceGeneration" Content="全量重渲染（覆盖）" IsChecked="False" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="重新生成全库可用音色，包括已有预览；新结果验证成功后覆盖，停止或失败时保留旧预览" AutomationProperties.Name="强制全量重新渲染并覆盖"/>
     <Button Click="Render_Click" IsEnabled="{Binding IsIdle}" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" ToolTip.Tip="生成或继续未完成预览"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="生成 / 继续"/></StackPanel></Button>
     <Button x:Name="StopTaskButton" Click="StopTask_Click" IsEnabled="{Binding CanStopTask}" ToolTip.Tip="停止当前任务，保留已经完成的预览" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="■" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="停止"/></StackPanel></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="TaskStatusBand" IsVisible="{Binding TaskBandVisible}" Grid.Row="1" Background="#EAF0EC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,10" AutomationProperties.Name="任务进度与结果">
   
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="TaskProgressTitle" Text="{Binding TaskTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    <StackPanel x:Name="TaskProgressMetadata" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding TaskProgressText}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding TaskElapsed}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
     <Button Content="打开新音色库" Click="OpenRelocatedLibrary_Click" IsVisible="{Binding RelocatedLibraryVisibility}" Margin="0,0,6,0" Padding="8,4" Height="30"/>
     <Button x:Name="ViewGeneratedButton" Click="ViewGenerated_Click" IsVisible="{Binding GeneratedResultsVisibility}" ToolTip.Tip="查看已生成的预览，包含待试听确认项" Margin="0,0,6,0" Padding="8,4" Height="30"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="查看已生成"/></StackPanel></Button>
     <Button Classes="icon" Content="↗" Click="ViewTasks_Click" ToolTip.Tip="查看任务与运行记录" Width="30" Height="30" Margin="0,0,6,0"/>
     <Button Classes="icon" Content="⚙" Click="ViewTaskSettings_Click" ToolTip.Tip="打开音源与渲染器设置" IsVisible="{Binding TaskSettingsVisibility}" Width="30" Height="30" Margin="0"/>
    </StackPanel>
    <TextBlock x:Name="TaskProgressDetails" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" LineHeight="16"  FontSize="12" Margin="0,4,0,8"/>
    <ProgressBar x:Name="GenerationProgressBar" Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="#D5DFD8" AutomationProperties.Name="任务总体进度"/>
   </Grid>
  </Border>
  <TabControl x:Name="Pages" Grid.Row="2" Margin="24,18,24,0" BorderThickness="0" Background="White">
   <TabItem Header="音色库">
    <Grid Background="White">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Margin="0,0,8,0" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Watermark="搜索音色、标签、包或目录" TextChanged="Filter_Changed" ToolTip.Tip="搜索音色名称、标签、MD5、包或文件路径" AutomationProperties.Name="搜索音色"/>
        
       </Grid>
       <ComboBox x:Name="SynthFilter" Grid.Column="1" ItemsSource="{Binding SynthFilters}" SelectedIndex="0" DisplayMemberBinding="{Binding Label}" SelectionChanged="Filter_Changed" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="音源筛选"/>
       <ComboBox x:Name="StatusFilter" Grid.Column="2" ItemsSource="{Binding StatusFilters}" SelectedIndex="0" DisplayMemberBinding="{Binding Label}" SelectionChanged="Filter_Changed" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="状态筛选"/>
       <CheckBox x:Name="FavoritesOnly" Grid.Column="3" Content="收藏" IsVisible="False" VerticalAlignment="Center" IsCheckedChanged="Filter_Changed"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="SourceFilter" ItemsSource="{Binding SourceFilters}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0" ToolTip.Tip="来源目录" AutomationProperties.Name="来源目录筛选"/>
       <ComboBox x:Name="PackageFilter" Grid.Column="1" ItemsSource="{Binding PackageFilters}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0" ToolTip.Tip="音色包" AutomationProperties.Name="音色包筛选"/>
       <ComboBox x:Name="CategoryFilter" Grid.Column="2" ItemsSource="{Binding CategoryFilters}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0" ToolTip.Tip="音色类别" AutomationProperties.Name="音色类别筛选"/>
       <ComboBox x:Name="TagFilter" Grid.Column="3" ItemsSource="{Binding TagFilters}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0" ToolTip.Tip="标签" AutomationProperties.Name="标签筛选"/>
       <ComboBox x:Name="FavoriteFilter" Grid.Column="4" ItemsSource="{Binding FavoriteFilters}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0" ToolTip.Tip="收藏状态" AutomationProperties.Name="收藏状态筛选"/>
       <Button Grid.Column="5" Classes="icon" Content="↺" Click="ClearFilters_Click" Width="34" Height="34" Margin="0" ToolTip.Tip="清除全部筛选" AutomationProperties.Name="清除全部筛选"/>
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="PresetFormatHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,12,0" VerticalAlignment="Center"
        Text="文件后缀：Vital .vital / .vitalbank；Serum 1 .fxp；Serum 2 .SerumPreset / .fxp；Sylenth1 .fxp / .fxb；Spire .spf / .spf2 / .sbf / .swzip（预览待适配）。音色包与银行暂仅索引。"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding VisiblePresetCount, StringFormat='筛选 {0} 项'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="RenderFilteredButton" Click="RenderFiltered_Click" IsEnabled="{Binding CanRenderFiltered}" Padding="10,6" ToolTip.Tip="生成当前筛选结果，跳过已有有效预览"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="生成筛选结果"/></StackPanel></Button>
        <Button x:Name="ColumnsButton" Click="ShowColumns_Click" Padding="10,6" Margin="0" ToolTip.Tip="选择音色列表显示列"><Button.ContextMenu><ContextMenu x:Name="ColumnsMenu" Opened="ColumnMenu_Opened"/></Button.ContextMenu><StackPanel Orientation="Horizontal"><TextBlock Text="☷" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="列"/></StackPanel></Button>
       </StackPanel>
      </Grid>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,18,0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Grid>
       <DataGrid x:Name="PresetGrid" ItemsSource="{Binding PresetsView}" IsReadOnly="True" SelectionChanged="Preset_SelectionChanged" DoubleTapped="Preset_DoubleClick" FrozenColumnCount="1" CanUserReorderColumns="True" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        
        <DataGrid.ContextMenu><ContextMenu Opened="ColumnMenu_Opened"/></DataGrid.ContextMenu>
        <DataGrid.Columns>
         <DataGridTextColumn Header="音色名称" Binding="{Binding Name}" Width="220" MinWidth="160"/>
         <DataGridTextColumn Header="音源" Binding="{Binding SynthLabel}" Width="95"/>
         <DataGridTextColumn Header="音色包 / 目录" Binding="{Binding Package}" Width="190" IsVisible="False"/>
         <DataGridTextColumn Header="类别" Binding="{Binding CategoryTagsLabel}" Width="160"/>
         <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="120"/>
         <DataGridTextColumn Header="反馈" Binding="{Binding FeedbackLabel}" Width="72" IsVisible="False"/>
         <DataGridTextColumn Header="收藏" Binding="{Binding FavoriteLabel}" Width="50"/>
         <DataGridTextColumn Header="时长" Binding="{Binding DurationLabel}" Width="85" IsVisible="False"/>
         <DataGridTextColumn Header="尝试" Binding="{Binding AttemptsLabel}" Width="60"/>
         <DataGridTextColumn Header="最近任务" Binding="{Binding LastRenderOutcomeLabel}" Width="110"/>
         <DataGridTextColumn Header="生成时间" Binding="{Binding RenderedLabel}" Width="150"/>
         <DataGridTextColumn Header="音源版本" Binding="{Binding PluginVersionLabel}" Width="120" IsVisible="False"/>
         <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="360"/>
         <DataGridTextColumn Header="最近任务原因" Binding="{Binding LastRenderMessageLabel}" Width="360" IsVisible="False"/>
         <DataGridTextColumn Header="标签" Binding="{Binding TagsLabel}" Width="230" IsVisible="False"/>
         <DataGridTextColumn Header="来源目录" Binding="{Binding SourceLabel}" Width="320" IsVisible="False"/>
         <DataGridTextColumn Header="源文件" Binding="{Binding SourcePathLabel}" Width="380" IsVisible="False"/>
         <DataGridTextColumn Header="适配器版本" Binding="{Binding AdapterVersionLabel}" Width="220" IsVisible="False"/>
         <DataGridTextColumn Header="文件 MD5" Binding="{Binding Record.ContentMd5}" Width="290" IsVisible="False"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel IsVisible="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
        <TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" FontSize="38" Foreground="#A6B9AE" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding EmptyMessage}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <Button Content="添加预制目录" Click="AddSourceFromLibrary_Click" Margin="0,20,0,0" IsEnabled="{Binding IsIdle}" IsVisible="{Binding EmptyLibraryVisibility}"/>
        <Button Content="清除筛选" Click="ClearFilters_Click" Margin="0,20,0,0" IsVisible="{Binding EmptyFilterVisibility}"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LibrarySummary}" ToolTip.Tip="{Binding LibrarySummary}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><CheckBox x:Name="ShowDuplicates" Grid.Column="1" Content="显示重复项" VerticalAlignment="Center" IsCheckedChanged="Filter_Changed" AutomationProperties.Name="显示重复项"/></Grid>
     </Grid>
     <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,8,0,0">
      <ScrollViewer x:Name="PresetDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="PresetDetailsContent">
        <TextBlock Text="{Binding Selected.Name, TargetNullValue=未选择音色, FallbackValue=未选择音色}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Selected.SynthLabel}" Foreground="{StaticResource Accent}" Margin="0,8,0,18"/>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="FavoriteButton" Classes="icon" Content="☆" Click="Favorite_Click" ToolTip.Tip="切换收藏" IsEnabled="{Binding CanEditSelection}"/>
         <Button Classes="icon" Content="＋" Click="Like_Click" ToolTip.Tip="喜欢 / 取消喜欢" IsEnabled="{Binding CanEditSelection}"/>
         <Button Classes="icon" Content="−" Click="Dislike_Click" ToolTip.Tip="不喜欢 / 取消反馈" IsEnabled="{Binding CanEditSelection}"/>
         <Button Classes="icon" Content="▣" Click="Locate_Click" ToolTip.Tip="定位原预制" IsEnabled="{Binding HasSelection}"/>
        </StackPanel>
        <Button Content="编辑标签与分类" Click="EditPresetMetadata_Click" IsEnabled="{Binding CanEditSelection}" Margin="0,8,0,0" Padding="10,6"/>
        <Expander x:Name="PresetMetadataExpander" Header="标签与分类" IsExpanded="False" Margin="0,16,0,0" HorizontalContentAlignment="Stretch">
         <StackPanel IsEnabled="{Binding CanEditSelection}">
          <TextBlock Text="分类" Classes="field-label"/><TextBox x:Name="PresetCategoriesEditor" AcceptsReturn="True" MinHeight="54" MaxHeight="100" TextWrapping="Wrap" AutomationProperties.Name="编辑音色分类"/>
          <TextBlock Text="标签" Classes="field-label"/><TextBox x:Name="PresetTagsEditor" AcceptsReturn="True" MinHeight="54" MaxHeight="100" TextWrapping="Wrap" AutomationProperties.Name="编辑音色标签"/>
          <TextBlock Text="用逗号或换行分隔。保存为手工内容后，重新扫描和自动分类不会覆盖。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8"/>
          <WrapPanel><Button Content="保存修改" Click="SavePresetMetadata_Click" Padding="10,6"/><Button Content="恢复自动" Click="ResetPresetMetadata_Click" Padding="10,6" Margin="0"/></WrapPanel>
         </StackPanel>
        </Expander>
        <TextBlock Text="状态" Classes="field-label"/><TextBlock Text="{Binding Selected.StatusLabel}"/>
        <TextBlock Text="{Binding Selected.Message}" TextWrapping="Wrap" Foreground="#97632E" Margin="0,6,0,0"/>
        <TextBlock Text="最近任务" Classes="field-label"/><TextBlock Text="{Binding Selected.LastRenderOutcomeLabel}"/><TextBlock Text="{Binding Selected.LastRenderMessageLabel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <TextBlock Text="来源" Classes="field-label"/><TextBox Text="{Binding Selected.Record.SourcePath}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"/>
        <TextBlock Text="{Binding Selected.Record.InternalPath}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="文件 MD5" Classes="field-label"/><TextBox Text="{Binding Selected.Record.ContentMd5}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/>
        <TextBlock Text="{Binding Selected.DuplicateLabel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Button Content="查看保留项" Click="ViewCanonical_Click" IsEnabled="{Binding CanViewCanonical}" IsVisible="{Binding CanonicalVisibility}" Margin="0,6,0,0"/>
        <TextBlock Text="识别依据" Classes="field-label"/><TextBlock Text="{Binding Selected.Record.DetectionReason}" TextWrapping="Wrap"/>

        <TextBlock Text="音源归属" Classes="field-label"/>
        <ComboBox x:Name="AssignmentSynthChoice" ItemsSource="{Binding SynthChoices}" DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Selected.Record.Synth, Mode=OneWay}" IsEnabled="{Binding CanAssignSynth}" AutomationProperties.Name="确认音色所属音源"/>
        <Button Content="确认音源标签" Click="AssignSynth_Click" IsEnabled="{Binding CanAssignSynth}" Margin="0,8,0,0"/>
        <TextBlock Text="预览" Classes="field-label"/><TextBlock Text="{Binding Selected.AudioLabel}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Selected.QualityLabel}" Foreground="#97632E" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="音源版本" Classes="field-label"/><TextBlock Text="{Binding Selected.Record.PluginVersion}"/>
        <Button Content="确认预览对应此音色" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Margin="0,20,0,0"/>
        <Button Content="重新生成此音色" Click="RenderSelected_Click" IsEnabled="{Binding CanRenderSelection}" Margin="0,8,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
   <TabItem x:Name="TasksTab" Header="运行记录">
    <Grid Background="White" Margin="0,16,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="重试失败任务" Click="Retry_Click" IsEnabled="{Binding CanRetryTasks}" ToolTip.Tip="重试当前失败或最近生成失败的音色，成功前保留已有预览"/>
      <Button Content="导出 MD5 索引" Click="Export_Click" IsEnabled="{Binding IsIdle}"/>
      <Button Content="打开本地数据目录" Click="OpenData_Click"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Text="运行记录" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" BorderThickness="0" Background="#F3F6F4" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
   <TabItem x:Name="SettingsTab" Header="音源与设置">
    <Grid Margin="0,10,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TabControl x:Name="SettingsPages" BorderThickness="0" Background="White">
      <TabItem x:Name="DirectorySettingsTab" Header="目录">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="390">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
         <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="240"/></Grid.RowDefinitions>
          <TextBlock Text="预制目录" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Grid Grid.Row="1" Margin="0,6,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <ComboBox x:Name="SourceSynthChoice" ItemsSource="{Binding SourceChoices}" DisplayMemberBinding="{Binding Label}" SelectedIndex="0" Margin="0,0,0,8" AutomationProperties.Name="目录音源识别方式"/>
           <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="添加目录" Click="AddSource_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"/>
            <Button Content="自动识别此目录" Click="AutoDetectSource_Click" IsEnabled="{Binding IsIdle}" Padding="10,6" ToolTip.Tip="将选中目录切换为混合音色自动识别"/>
            <Button Classes="icon" Content="×" Click="RemoveSource_Click" IsEnabled="{Binding IsIdle}" Width="34" Height="32" Margin="0" ToolTip.Tip="移除选中的预制目录"/>
           </StackPanel>
          </Grid>
          <DataGrid x:Name="SourceGrid" Grid.Row="2" ItemsSource="{Binding Sources}" MinHeight="240" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
           <DataGrid.Columns>
            <DataGridTemplateColumn Header="识别方式" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path=., Converter={StaticResource SourceDetection}}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" MinWidth="230"/>
           </DataGrid.Columns>
          </DataGrid>
         </Grid>
         <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Margin="0,12,0,0"/>
         <Grid Grid.Column="2" Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="240"/></Grid.RowDefinitions>
          <TextBlock Text="音源安装目录" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="首次使用已预填系统和用户的安装位置，可追加自定义目录。空列表扫描时恢复默认位置。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          <WrapPanel Grid.Row="2" Margin="0,6,0,10">
           <Button Click="AddPluginDirectory_Click" IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="添加安装目录"/></StackPanel></Button>
           <Button x:Name="DirectoryScanPluginsButton" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="扫描音源"/></StackPanel></Button>
           <Button Classes="icon" Content="×" Click="RemovePluginDirectory_Click" IsEnabled="{Binding IsIdle}" Width="34" Height="32" Margin="0,0,0,8" ToolTip.Tip="移除选中的安装目录"/>
          </WrapPanel>
          <DataGrid x:Name="PluginDirectoryGrid" Grid.Row="3" ItemsSource="{Binding PluginDirectories}" MinHeight="240" IsReadOnly="True" AutomationProperties.Name="音源安装目录" ScrollViewer.HorizontalScrollBarVisibility="Auto">
           <DataGrid.Columns><DataGridTextColumn Header="安装目录" Binding="{Binding}" Width="*" MinWidth="300"/></DataGrid.Columns>
          </DataGrid>
         </Grid>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="DiscoveredSettingsTab" Header="已发现音源">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="365">
         <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*" MinHeight="240"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="音源扫描结果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button x:Name="DiscoveredScanPluginsButton" Content="扫描音源" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="扫描安装目录并更新此列表"/>
           <Button Content="安装目录" Click="ViewPluginDirectories_Click" IsEnabled="{Binding IsIdle}"/>
           <Button Content="使用选中版本" Click="UseDiscoveredPlugin_Click" IsEnabled="{Binding IsIdle}" Margin="0"/>
          </StackPanel>
         </Grid>
         <DataGrid x:Name="DiscoveredPluginGrid" Grid.Row="1" ItemsSource="{Binding DiscoveredPlugins}" MinHeight="240" IsReadOnly="True" AutomationProperties.Name="音源扫描结果" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
           <DataGridTextColumn Header="插件 / 音源" Binding="{Binding NameLabel}" Width="170"/>
           <DataGridTextColumn Header="版本" Binding="{Binding Record.Version}" Width="110"/>
           <DataGridTextColumn Header="位数" Binding="{Binding ArchitectureLabel}" Width="65"/>
           <DataGridTextColumn Header="格式" Binding="{Binding FormatLabel}" Width="75"/>
           <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="110"/>
           <DataGridTextColumn Header="文件" Binding="{Binding Record.FilePath}" Width="*" MinWidth="300"/>
          </DataGrid.Columns>
         </DataGrid>
         <TextBlock Grid.Row="2" Text="{Binding SelectedItem.Record.Reason, ElementName=DiscoveredPluginGrid}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,4" MaxHeight="54"/>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="RenderSettingsTab" Header="预览生成">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="560">
         <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="330"/></Grid.ColumnDefinitions>
         <Expander x:Name="RendererSettings" Header="生成方式（高级）" IsExpanded="True" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
          <TextBlock Text="生成预览时，需要让本机音源演奏所选音色并保存为音频。先扫描并关联音源，再为它选择生成方式；已有的预览可直接试听。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
           <CheckBox x:Name="ParallelRendering" Content="并行生成（试验，最多 2 个任务）" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="启用两个并行生成任务"/>
           <TextBlock Text="默认串行。开启后可同时处理不同音源；同一音源须在下表勾选“允许同时生成”。若插件不稳定，请恢复串行；首次使用或更新 Vital 后请先单独生成一次。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
          <DataGrid x:Name="PluginGrid" Grid.Row="2" ItemsSource="{Binding Plugins}" MinHeight="260" RowHeight="42" IsReadOnly="False" IsEnabled="{Binding IsIdle}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
           <DataGrid.Columns>
            <DataGridTextColumn Header="音源" Binding="{Binding Synth}" Width="92" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="方式" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{StaticResource RenderBackendValues}" DisplayMemberBinding="{Binding Converter={StaticResource BackendLabel}}" SelectedIndex="{Binding Backend, Mode=TwoWay, Converter={StaticResource BackendIndex}}" Margin="0,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridCheckBoxColumn Header="允许同时生成" Binding="{Binding AllowParallelRendering, Mode=TwoWay}" Width="125"/>
            <DataGridTemplateColumn Header="渲染程序" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Classes="icon" Content="▣" Tag="{Binding}" Click="BrowsePlugin_Click" ToolTip.Tip="选择预览宿主或外部渲染程序" Width="32" Height="30" Margin="4,0,0,0"/><TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5,4"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="已关联插件" Binding="{Binding PluginPath}" Width="260" IsReadOnly="True"/>
            <DataGridTextColumn Header="实际版本" Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            <DataGridTextColumn Header="超时 (秒)" Binding="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
           </DataGrid.Columns>
          </DataGrid>
          </Grid>
         </Expander>
         <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Margin="0,12,0,0"/>
         <TabControl Grid.Column="2" Margin="0,8,0,0" Background="White" BorderThickness="0">
          <TabItem Header="加载防错检查">
           <Grid RowDefinitions="Auto,*">
           <TextBlock Text="有些音源加载音色失败后仍会播放默认声音。这里记录音源刚启动时的声音作参照，避免把它误当成目标音色保存。支持的音源会在生成时自动建立参照，通常无需手动操作。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,10"/>
           <DataGrid x:Name="InitializationGrid" Grid.Row="1" ItemsSource="{Binding InitBaselines}" MinHeight="240" IsReadOnly="True" AutomationProperties.Name="音源加载防错声音参照" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
             <DataGridTextColumn Header="音源" Binding="{Binding Synth}" Width="85"/>
             <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
             <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="*" MinWidth="140"/>
             <DataGridTemplateColumn Header="操作" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Classes="icon" Content="↻" Click="GenerateInitBaseline_Click" Tag="{Binding}" IsEnabled="{Binding CanGenerate}" Width="32" Height="30" Margin="0,0,4,0" ToolTip.Tip="生成或更新初始音色基准"/><Button Classes="icon" Content="▶" Click="PlayInitBaseline_Click" Tag="{Binding}" IsEnabled="{Binding CanPlay}" Width="32" Height="30" Margin="0" ToolTip.Tip="试听已生成的初始音色基准"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
           </DataGrid>
           </Grid>
          </TabItem>
          <TabItem Header="配置状态">
           <DataGrid x:Name="CompatibilityGrid" ItemsSource="{Binding Compatibility}" IsReadOnly="True" MinHeight="240" RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="音源" Binding="{Binding Synth}" Width="90"/><DataGridTextColumn Header="配置检查" Binding="{Binding Status}" Width="110"/><DataGridTemplateColumn Header="原因与预览输出" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="4,6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
          </TabItem>
         </TabControl>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="StorageSettingsTab" Header="试听与存储">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,12,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="350"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="三音区试听模板" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <CheckBox x:Name="QuickPreviewMode" Content="快速预览" IsChecked="True" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8" ToolTip.Tip="慢起音自动延长采集，再按设定的每音时长截取，不提高原始音量"/>
          <StackPanel IsEnabled="{Binding #QuickPreviewMode.IsChecked}" Margin="0,0,0,8"><TextBlock Text="每个音区的快速预览时长（秒）" Classes="field-label"/><TextBox x:Name="QuickPreviewSecondsBox" Text="0.5" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="快速预览每音时长"/><TextBlock Text="默认 0.5 秒，可设 0.1–4 秒；三个音区依次播放。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
          <Grid IsEnabled="{Binding IsIdle}">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <StackPanel><TextBlock Text="低音（C2）" Classes="field-label"/><TextBox x:Name="LowNoteBox" Watermark="C2"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="中音（C4）" Classes="field-label"/><TextBox x:Name="MiddleNoteBox" Watermark="C4"/></StackPanel>
           <StackPanel Grid.Column="4"><TextBlock Text="高音（C6）" Classes="field-label"/><TextBox x:Name="HighNoteBox" Watermark="C6"/></StackPanel>
           <StackPanel Grid.Row="1"><TextBlock Text="力度" Classes="field-label"/><TextBox x:Name="VelocityBox"/></StackPanel>
           <StackPanel Grid.Row="1" Grid.Column="2" IsEnabled="{Binding !#QuickPreviewMode.IsChecked}"><TextBlock Text="按键时长 (秒)" Classes="field-label"/><TextBox x:Name="HoldBox"/></StackPanel>
           <StackPanel Grid.Row="1" Grid.Column="4" IsEnabled="{Binding !#QuickPreviewMode.IsChecked}"><TextBlock Text="尾音 (秒)" Classes="field-label"/><TextBox x:Name="TailBox"/></StackPanel>
           <StackPanel Grid.Row="2"><TextBlock Text="BPM" Classes="field-label"/><TextBox x:Name="BpmBox"/></StackPanel>
           <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"><TextBlock Text="采样率 (Hz)" Classes="field-label"/><ComboBox x:Name="SampleRateBox"><ComboBoxItem Content="44100"/><ComboBoxItem Content="48000"/></ComboBox></StackPanel>
          </Grid>
          <WrapPanel Margin="0,16,0,0"><Button Content="采用 Vital 原生参数" Click="VitalDefaults_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><TextBlock Text="力度 0.7 · 整秒按键 · 尾音 30%" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="本地数据与预览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
          <TextBlock Text="数据库、预览音频、标签和分类默认存放在程序旁的 Preview。更改位置时统一迁移记录，并选择迁移或清除旧预览。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          <TextBlock Text="当前数据库与标签目录" Classes="field-label"/>
          <TextBox Text="{Binding LibraryLocation, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="当前音色库数据目录"/>
          <Grid IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,8,0"><TextBlock Text="当前音频目录" Classes="field-label"/><TextBox x:Name="PreviewDirectoryBox" IsReadOnly="True"/></StackPanel>
           <Button Grid.Column="1" Classes="icon" Content="▣" Click="BrowsePreview_Click" ToolTip.Tip="更改数据与预览目录：迁移或清除旧预览" VerticalAlignment="Bottom" Width="34" Height="34" Margin="0"/>
          </Grid>
          <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}"><Button Content="更改目录" Click="BrowsePreview_Click" Padding="10,6" Margin="0,0,8,8"/><Button Content="使用默认 Preview" Click="UseDefaultPreviewDirectory_Click" Padding="10,6" Margin="0,0,8,8"/><Button Content="清空预览" Click="ClearPreviews_Click" Padding="10,6" Margin="0,0,0,8"/></WrapPanel>
          <Button Content="打开已有音色库" Click="OpenExistingLibrary_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,0,4" Padding="10,6" ToolTip.Tip="选择旧版 library.db 所在目录；打开成功后记住位置"/>
          <Grid IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="存储预算 (GB)" Classes="field-label"/><TextBox x:Name="BudgetBox"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="最大尝试次数" Classes="field-label"/><TextBox x:Name="AttemptsBox"/></StackPanel>
          </Grid>
         </StackPanel>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ClassificationSettingsTab" Header="分类规则">
       <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="RulesPathBox" IsReadOnly="True" Margin="0,0,8,0" AutomationProperties.Name="分类规则文件路径"/><Button Grid.Column="1" Classes="icon" Content="↗" Click="OpenCategoryRules_Click" Width="34" Height="34" Margin="0" ToolTip.Tip="打开分类规则文件"/></Grid>
        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
         <Button Click="ReloadCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="重新载入"/></StackPanel></Button>
         <Button Click="SaveCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="保存并应用"/></StackPanel></Button>
         <Button Click="ApplyCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="重新应用已保存规则"/></StackPanel></Button>
        </WrapPanel>
        <TextBox x:Name="RulesEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" FontFamily="Menlo, Consolas, monospace" FontSize="13" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="{Binding IsBusy}" VerticalContentAlignment="Top" AutomationProperties.Name="分类规则 JSON"/>
        <TextBlock x:Name="ClassificationStatus" Grid.Row="3" Text="{Binding CategoryRulesStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" MaxHeight="48"/>
       </Grid>
      </TabItem>
     </TabControl>
     <Grid Grid.Row="1" Height="36" Margin="0,8,0,4" IsVisible="{Binding !#ClassificationSettingsTab.IsSelected}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Click="SaveSettings_Click" Background="{StaticResource Accent}" Foreground="White" Margin="0" Padding="14,6" IsEnabled="{Binding IsIdle}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="保存设置"/></StackPanel></Button></Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" IsVisible="{Binding !#SettingsTab.IsSelected}" Height="120" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
   
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding NowPlaying}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
     <StackPanel Orientation="Horizontal">
      <Button Classes="icon" Content="▶" Click="Play_Click" ToolTip.Tip="播放 / 暂停" IsEnabled="{Binding CanPlay}"/>
      <Button Classes="icon" Content="■" Click="Stop_Click" ToolTip.Tip="停止播放" IsEnabled="{Binding CanPlay}"/>
      <Button Content="中" Click="PlayNote_Click" Tag="Middle" Padding="10,6" Width="40" Height="36" ToolTip.Tip="试听中音区" IsEnabled="{Binding CanPlay}"/>
      <Button Content="高" Click="PlayNote_Click" Tag="High" Padding="10,6" Width="40" Height="36" ToolTip.Tip="试听高音区" IsEnabled="{Binding CanPlay}"/>
      <Button Content="低" Click="PlayNote_Click" Tag="Low" Padding="10,6" Width="40" Height="36" ToolTip.Tip="试听低音区" IsEnabled="{Binding CanPlay}"/>
     </StackPanel>
    </StackPanel>
    <Grid Grid.Column="1" Margin="16,0,20,0"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="20"/></Grid.RowDefinitions>
     <local:WaveformView x:Name="Waveform"/>
     <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="播放位置"/>
    </Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,0,14"/>
     <DockPanel><TextBlock Text="♪" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" AutomationProperties.Name="试听音量"/></DockPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="4" Background="#EAF0EC" Padding="24,0">
   <DockPanel>
    <TextBlock x:Name="BuildVersionLabel" DockPanel.Dock="Right" Text="{Binding AppVersion}" ToolTip.Tip="{Binding BuildLocation}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
    <TextBlock x:Name="StatusFooterText" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
