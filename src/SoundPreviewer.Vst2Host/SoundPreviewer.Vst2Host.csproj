<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platform>x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoundPreviewer.Vst2Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VST.NET2-Host" Version="2.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="Jacobi.Vst.Core"><HintPath>$(PkgVST_NET2-Host)/lib/net6.0/x86/Jacobi.Vst.Core.dll</HintPath></Reference>
    <Reference Include="Jacobi.Vst.Host.Interop"><HintPath>$(PkgVST_NET2-Host)/lib/net6.0/x86/Jacobi.Vst.Host.Interop.dll</HintPath></Reference>
    <None Include="$(PkgVST_NET2-Host)/runtimes/win10-x86/native/Ijwhost.dll" Link="Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SoundPreviewer.Core/SoundPreviewer.Core.csproj" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE.VST.NET.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE.Microsoft.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
